# Credenciales y Configuración para SIIA Abisalud
SIIA_URL=https://siia.abisalud.com/main.php
SIIA_USERNAME=tu_usuario_aqui
SIIA_PASSWORD=tu_contraseña_aqui

# Configuración de Automatización (Playwright)
# HEADLESS=False para ver el navegador mientras trabaja, True para segundo plano
HEADLESS=False
SLOW_MO=300

# Base de Datos (Por defecto SQLite local, o cambiar a postgresql://user:pass@localhost/db)
DATABASE_URL=sqlite:///data/abisalud.db

# Rutas de Archivos
DOWNLOAD_DIR=downloads
PROCESSED_DIR=downloads/processed
